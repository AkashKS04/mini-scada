{
  "_comment": "Master configuration for Mini SCADA Phase 4 — 11kV Distribution Substations",
  "_version": "1.0",
  "_based_on": "BESCOM-style 33/11kV distribution substations, Bengaluru",

  "system": {
    "name": "Mini SCADA — 11kV Distribution Network",
    "utility": "BESCOM (Bruhat Bengaluru Electricity Supply Company)",
    "voltage_levels": ["33kV", "11kV", "0.415kV"],
    "nominal_frequency_hz": 50,
    "poll_interval_seconds": 3
  },

  "alarm_priority_rules": {
    "CRITICAL": {
      "manual_ack_required": true,
      "auto_clear": false,
      "description": "High-High or Low-Low limit breach, Breaker TRIP — operator must manually ACK and clear"
    },
    "HIGH": {
      "manual_ack_required": true,
      "auto_clear": false,
      "description": "High or Low limit breach, Comms failure — operator must manually ACK and clear"
    },
    "MEDIUM": {
      "manual_ack_required": false,
      "auto_clear": true,
      "description": "Data quality degraded, freeze — auto-ACK and auto-clear when condition resolves"
    },
    "LOW": {
      "manual_ack_required": false,
      "auto_clear": true,
      "description": "Informational, device restored — auto-ACK and auto-clear"
    }
  },

  "register_map": {
    "_comment": "Same register map for every Modbus slave device",
    "40001": { "parameter": "voltage",      "unit": "kV",   "scale": 100,  "description": "Voltage (stored as kV x100, e.g. 1100 = 11.00kV)" },
    "40002": { "parameter": "current",      "unit": "A",    "scale": 10,   "description": "Current (stored as A x10)" },
    "40003": { "parameter": "power_mw",     "unit": "MW",   "scale": 100,  "description": "Active power (stored as MW x100, e.g. 250 = 2.50MW)" },
    "40004": { "parameter": "power_factor", "unit": "",     "scale": 100,  "description": "Power factor (stored as x100, e.g. 95 = 0.95)" },
    "40005": { "parameter": "temperature",  "unit": "degC", "scale": 10,   "description": "Temperature (stored as degC x10, transformer only)" },
    "40006": { "parameter": "frequency",    "unit": "Hz",   "scale": 100,  "description": "Frequency (stored as Hz x100, e.g. 5000 = 50.00Hz)" },
    "40100": { "parameter": "breaker_state","unit": "",     "scale": 1,    "description": "Breaker state: 0=OPEN, 1=CLOSED, 2=TRIPPED, 3=UNKNOWN" }
  },

