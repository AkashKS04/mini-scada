[Unit]
Description=SCADA Data Collector and Alarm Engine
Documentation=https://github.com/AkashKS04/mini-scada
# Start after network AND after scada-server is running
After=network.target scada-server.service
Requires=scada-server.service

[Service]
# Where your project lives
WorkingDirectory=/home/akash/mini-scada

# What to run
ExecStart=/usr/bin/python3 /home/akash/mini-scada/modbus_client.py

# Restart automatically if it crashes
Restart=always

# Wait 5 seconds before restarting
# Gives scada-server time to fully start before client reconnects
RestartSec=5

# Run as your user, never as root
User=akash

# Log stdout and stderr to journald
StandardOutput=journal
StandardError=journal

# Give it a unique syslog identifier (for journalctl filtering)
SyslogIdentifier=scada-client

[Install]
WantedBy=multi-user.target
